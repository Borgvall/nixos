cabal-version:      2.4
name:               swayhelper
version:            0.1.0.0
synopsis:           Small helper for sway's IPC workspace switching
description:
  swayhelper talks to sway's i3-compatible IPC socket directly and is used
  by the next-workspace bindings.  When the focused workspace is the last
  one, it creates a new workspace at the end instead of wrapping around.
license:            BSD-3-Clause
author:             Johannes Röhl
maintainer:         joroehl@gmx.de
build-type:         Simple

executable swayhelper
  main-is:          Main.hs
  hs-source-dirs:   src
  build-depends:    base >=4.18 && <5
                  , aeson >=2.2 && <3
                  , bytestring >=0.11 && <0.13
                  , network >=3.2 && <4
  default-language: Haskell2010
  ghc-options:      -Wall
